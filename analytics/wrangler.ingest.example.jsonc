{
  "name": "compute-intelligence-ingest",
  "main": "worker.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
    },
    "traces": {
      "enabled": true,
    },
  },
  "vars": {
    "SITE_ORIGIN": "https://darkstarstrix.github.io",
    "SNAPSHOT_URL": "https://darkstarstrix.github.io/Compute_Intelligence/data/current.json",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "compute-intelligence-analytics",
      "database_id": "REPLACE_WITH_ANALYTICS_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "IP_LIMIT",
      "namespace_id": "61001",
      "simple": {
        "limit": 120,
        "period": 60,
      },
    },
    {
      "name": "SESSION_LIMIT",
      "namespace_id": "61002",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["*/15 * * * *", "17 3 * * *"],
  },
}
